GROQ_API_KEY_1=xxxxxxxxxxxxxxxx
GROQ_API_KEY_2=xxxxxxxxxxxxxxxx
GROQ_API_KEY_3=xxxxxxxxxxxxxxxx
GROQ_API_KEY_4=xxxxxxxxxxxxxxxx
GROQ_API_KEY_5=xxxxxxxxxxxxxxxx

# Hindsight memory
# Local/self-hosted default:
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=jarvis-user

# Only needed when using Hindsight Cloud:
# HINDSIGHT_API_KEY=hsk_xxxxxxxxxxxxxxxx

# Used by the local Hindsight server for memory extraction.
# You can reuse one of your existing Groq keys.
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_API_LLM_API_KEY=xxxxxxxxxxxxxxxx

# Hindsight defaults Groq to service_tier=auto. Free-tier Groq accounts
# should use on_demand to avoid HTTP 400 service-tier errors.
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
